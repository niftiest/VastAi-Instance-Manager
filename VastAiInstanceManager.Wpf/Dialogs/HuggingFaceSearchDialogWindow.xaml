<Window x:Class="VastAiInstanceManager.Wpf.Dialogs.HuggingFaceSearchDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Hugging Face - Vast.ai Instance Manager"
        Width="1240" Height="640"
        MinWidth="960" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <CheckBox DockPanel.Dock="Right" x:Name="GgufOnlyBox" IsChecked="True" Content="GGUF only"
                      Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <TextBox x:Name="QueryBox" TextChanged="QueryBox_TextChanged" />
        </DockPanel>

        <TextBlock Grid.Row="1" x:Name="StatusText" Foreground="{StaticResource TextSecondary}" Margin="0,8" />

        <DataGrid Grid.Row="2" x:Name="ResultsGrid"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  MouseDoubleClick="Results_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="380" />
                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="140" />
                <DataGridTextColumn Header="Downloads" Binding="{Binding Downloads}" Width="100" />
                <DataGridTextColumn Header="Likes" Binding="{Binding Likes}" Width="70" />
                <DataGridTextColumn Header="GGUF size" Binding="{Binding Size}" Width="120" />
                <DataGridTextColumn Header="Tools" Binding="{Binding Tools}" Width="60" />
                <DataGridTextColumn Header="Modal" Binding="{Binding Modal}" Width="70" />
                <DataGridTextColumn Header="Added" Binding="{Binding Added}" Width="100" />
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,10,0,0">
            <Hyperlink Click="OpenHf_Click" Foreground="{StaticResource AccentPrimary}">
                Open selected on huggingface.co
            </Hyperlink>
        </TextBlock>

        <DockPanel Grid.Row="4" LastChildFill="False" Margin="0,12,0,0">
            <Button x:Name="ManualButton" DockPanel.Dock="Left" Content="Enter manually" Click="Manual_Click"
                    Visibility="Collapsed" Width="140" Height="32" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Width="100" Height="32" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Select" Click="Select_Click"
                    Style="{StaticResource PrimaryButton}" Width="120" Height="32" />
        </DockPanel>
    </Grid>
</Window>
