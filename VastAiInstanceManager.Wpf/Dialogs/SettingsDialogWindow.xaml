<Window x:Class="VastAiInstanceManager.Wpf.Dialogs.SettingsDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Vast.ai Instance Manager"
        Width="560" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="vast.ai API Key" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" />
        <TextBlock Grid.Row="1" Text="API key:" Margin="0,0,0,4" />

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Two stacked inputs at the same cell - only one is visible at a time, driven by
                 ShowKeyBox.IsChecked. PlainKeyBox.Text mirrors KeyBox.Password on toggle so the
                 user sees what they last typed regardless of mode. -->
            <PasswordBox Grid.Column="0" x:Name="KeyBox" />
            <TextBox     Grid.Column="0" x:Name="PlainKeyBox" Visibility="Collapsed" />
            <CheckBox    Grid.Column="1" x:Name="ShowKeyBox" Content="Show" Margin="10,0,0,0"
                         Foreground="{StaticResource TextSecondary}"
                         Checked="ShowKeyBox_Toggled" Unchecked="ShowKeyBox_Toggled" />
        </Grid>

        <Button Grid.Row="3" x:Name="TestButton" Content="Test" Width="100" Height="30"
                HorizontalAlignment="Left" Click="TestButton_Click" Margin="0,0,0,8" />

        <TextBlock Grid.Row="4" x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Grid.Row="5" x:Name="PathText" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />

        <DockPanel Grid.Row="6" LastChildFill="False" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Width="96" Height="30" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Save" IsDefault="True" Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButton}" Width="100" Height="30" />
        </DockPanel>
    </Grid>
</Window>
