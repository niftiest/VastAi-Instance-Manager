<Window x:Class="VastAiInstanceManager.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VastAiInstanceManager.Wpf.ViewModels"
        xmlns:conv="clr-namespace:VastAiInstanceManager.Wpf.Converters"
        Title="Vast.ai Instance Manager"
        Width="1280" Height="860" MinWidth="1000" MinHeight="750"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:NullToVisibilityConverter x:Key="NullVis" />
        <conv:InstanceStatusToBrushConverter x:Key="StatusBrush" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />     <!-- toolbar -->
            <RowDefinition Height="*" MinHeight="280" />  <!-- offers -->
            <RowDefinition Height="*" MinHeight="200" />  <!-- instances -->
            <RowDefinition Height="Auto" />     <!-- progress -->
            <RowDefinition Height="140" />      <!-- log -->
            <RowDefinition Height="Auto" />     <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
            <ComboBox Width="360" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                      DisplayMemberPath="Key" VerticalAlignment="Center" />
            <Button Content="Refresh Offers" Command="{Binding SearchCommand}"
                    Width="130" Height="30" Margin="8,0,0,0" />
            <Button Content="Rent &amp; Setup" Command="{Binding RentCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Width="130" Height="30" Margin="8,0,0,0" />
            <Button Content="Cancel" Command="{Binding CancelSpinupCommand}"
                    Style="{StaticResource DangerButton}"
                    Width="80" Height="30" Margin="8,0,0,0" />

            <Button DockPanel.Dock="Right" Content="vast.ai console" Command="{Binding OpenConsoleCommand}"
                    Width="120" Height="30" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Settings" Command="{Binding SettingsCommand}"
                    Width="80" Height="30" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Manage Models" Command="{Binding ManageModelsCommand}"
                    Width="130" Height="30" Margin="8,0,0,0" />
        </DockPanel>

        <!-- Offers -->
        <GroupBox Grid.Row="1" Header="Available Providers" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid x:Name="OffersGrid" Grid.Row="0"
                          ItemsSource="{Binding Offers}"
                          SelectedItem="{Binding SelectedOffer}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="★" Binding="{Binding FavoriteCell}" Width="32" />
                        <DataGridTextColumn Header="GPU" Binding="{Binding Gpu}" Width="200" SortMemberPath="Offer.GpuName" />
                        <DataGridTextColumn Header="VRAM" Binding="{Binding Vram}" Width="70" SortMemberPath="Offer.TotalVramGb" />
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="130" />
                        <DataGridTextColumn Header="Price/hr" Binding="{Binding Price}" Width="80" SortMemberPath="Offer.DphTotal" />
                        <DataGridTextColumn Header="Boot" Binding="{Binding Boot}" Width="70" />
                        <DataGridTextColumn Header="Rel." Binding="{Binding Reliability}" Width="70" SortMemberPath="Offer.Reliability" />
                        <DataGridTextColumn Header="VRAM BW (GB/s)" Binding="{Binding Bw}" Width="110" SortMemberPath="Offer.GpuMemBwGbs" />
                        <DataGridTextColumn Header="Est t/s" Binding="{Binding Tps}" Width="90" />
                        <DataGridTextColumn Header="Disk" Binding="{Binding Disk}" Width="80" SortMemberPath="Offer.DiskSpaceGb" />
                        <DataGridTextColumn Header="Net (D/U)" Binding="{Binding Net}" Width="120" />
                        <DataGridTextColumn Header="DL $/TB" Binding="{Binding DlCost}" Width="80" SortMemberPath="Offer.InetDownCostPerGb" />
                        <DataGridTextColumn Header="Pull $" Binding="{Binding PullCost}" Width="70" SortMemberPath="Offer.InetDownCostPerGb" />
                        <DataGridTextColumn Header="Cached" Binding="{Binding Cached}" Width="70" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Note}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Note}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <EventSetter Event="MouseDoubleClick" Handler="OffersRow_DoubleClick" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentWarning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource PickLink}" Text="{Binding BestPriceText}"
                               Foreground="{StaticResource AccentSuccess}"
                               MouseLeftButtonUp="BestPrice_Click" Cursor="Hand" />
                    <TextBlock Style="{StaticResource PickLink}" Text="{Binding FastestText}"
                               Foreground="{StaticResource AccentPrimary}"
                               MouseLeftButtonUp="Fastest_Click" Cursor="Hand" />
                    <TextBlock Style="{StaticResource PickLink}" Text="{Binding BestValueText}"
                               Foreground="{StaticResource AccentWarning}"
                               MouseLeftButtonUp="BestValue_Click" Cursor="Hand" />
                </UniformGrid>
            </Grid>
        </GroupBox>

        <!-- Instances -->
        <GroupBox Grid.Row="2" Header="My Instances" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding SelectedInstance}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Instance ID" Binding="{Binding Id}" Width="100" />
                        <DataGridTextColumn Header="GPU" Binding="{Binding Gpu}" Width="200" />
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="$/hr" Binding="{Binding Price}" Width="80" />
                        <DataGridTextColumn Header="Uptime" Binding="{Binding Uptime}" Width="110" />
                        <DataGridTextColumn Header="Spent" Binding="{Binding Spent}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding SpentDetail}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="240" />
                        <DataGridTextColumn Header="Public IP" Binding="{Binding Ip}" Width="140" />
                        <DataGridTextColumn Header="SSH" Binding="{Binding Ssh}" Width="180" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Message}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Refresh" Command="{Binding RefreshInstancesCommand}" Width="100" Height="30" />
                    <Button Content="Use (wire up opencode)" Command="{Binding UseInstanceCommand}" Width="180" Height="30" Margin="8,0,0,0" />
                    <Button Content="{Binding FavoriteButtonText}" Command="{Binding FavoriteInstanceCommand}" Width="120" Height="30" Margin="8,0,0,0" />
                    <Button Content="{Binding NotesButtonText}" Command="{Binding NotesInstanceCommand}" Width="120" Height="30" Margin="8,0,0,0" />
                    <Button Content="Change Model" Command="{Binding ChangeModelCommand}" Width="130" Height="30" Margin="8,0,0,0" />
                    <Button Content="Start" Command="{Binding StartInstanceCommand}" Style="{StaticResource PrimaryButton}" Width="80" Height="30" Margin="8,0,0,0" />
                    <Button Content="Stop" Command="{Binding StopInstanceCommand}" Style="{StaticResource DangerButton}" Width="80" Height="30" Margin="8,0,0,0" />
                    <Button Content="Destroy" Command="{Binding DestroyInstanceCommand}" Style="{StaticResource DangerButton}" Width="100" Height="30" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Progress -->
        <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding Progress}"
                     Visibility="{Binding ProgressVisible, Converter={StaticResource BoolVis}}"
                     Margin="0,0,0,8" />

        <!-- Log -->
        <TextBox Grid.Row="4" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextChanged="LogBox_TextChanged"
                 x:Name="LogBox" />

        <!-- Status bar -->
        <StatusBar Grid.Row="5" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding Balance}" Foreground="{StaticResource TextSecondary}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
