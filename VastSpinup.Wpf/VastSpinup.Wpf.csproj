<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VastSpinup.Wpf</RootNamespace>
    <AssemblyName>VastSpinup.Wpf</AssemblyName>

    <!-- Assembly + product metadata. Surfaces in app properties, log lines, and crash reports. -->
    <Product>VastSpinup</Product>
    <AssemblyTitle>VastSpinup</AssemblyTitle>
    <Description>WPF desktop app for provisioning vast.ai GPU instances and wiring them up to local Ollama / OpenCode workflows.</Description>
    <Authors>cpaec</Authors>
    <Company>cpaec</Company>
    <Copyright>Copyright © cpaec</Copyright>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF's implicit-usings set doesn't include these; Services/Models rely on Path/File/Directory and HttpClient. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

</Project>
