<Window x:Class="VastSpinup.Wpf.Dialogs.ModelEditDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model"
        Width="620" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Key (e.g. llama-70b)" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="KeyBox" Margin="0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Display name" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="NameBox" Margin="0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ollama tag" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TagBox" Margin="0,4" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Min VRAM (GB)" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="VramBox" Margin="0,4" Width="120" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Min disk (GB)" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="DiskBox" Margin="0,4" Width="120" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Model size on disk (GB)" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="5" Grid.Column="1" x:Name="SizeBox" Margin="0,4" Width="120" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Context length" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="6" Grid.Column="1" x:Name="CtxBox" Margin="0,4" Width="120" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Temperature" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="7" Grid.Column="1" x:Name="TempBox" Margin="0,4" Width="120" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="8" Grid.Column="0" Text="top_p" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="8" Grid.Column="1" x:Name="TopPBox" Margin="0,4" Width="120" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="9" Grid.Column="0" Text="top_k" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="9" Grid.Column="1" x:Name="TopKBox" Margin="0,4" Width="120" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Max $/hr (0 = no cap)" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="10" Grid.Column="1" x:Name="MaxPriceBox" Margin="0,4" Width="120" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="11" Grid.Column="0" Text="Min reliability (0-1)" VerticalAlignment="Center" Margin="0,4" />
        <TextBox   Grid.Row="11" Grid.Column="1" x:Name="MinRelBox" Margin="0,4" Width="120" HorizontalAlignment="Left" />

        <TextBlock Grid.Row="12" Grid.Column="0" Text="Notes" VerticalAlignment="Top" Margin="0,8" />
        <TextBox   Grid.Row="12" Grid.Column="1" x:Name="NotesBox" Margin="0,8"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" MinHeight="80" />

        <DockPanel Grid.Row="13" Grid.ColumnSpan="2" LastChildFill="False" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Search Hugging Face..." Click="HfSearch_Click"
                    Width="200" Height="32" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Width="100" Height="32" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Save" IsDefault="True" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}" Width="100" Height="32" />
        </DockPanel>
    </Grid>
</Window>
