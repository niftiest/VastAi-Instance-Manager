<Window x:Class="VastSpinup.Wpf.Dialogs.NotesDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Host Notes - VastSpinup"
        Width="560" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Host Notes" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" x:Name="InfoText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
        <TextBox Grid.Row="2" x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" MaxLength="2000" />
        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Clear Notes" Click="ClearButton_Click" Width="110" Height="30" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Width="96" Height="30" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Save" IsDefault="True" Click="OkButton_Click"
                    Style="{StaticResource PrimaryButton}" Width="100" Height="30" />
        </DockPanel>
    </Grid>
</Window>
