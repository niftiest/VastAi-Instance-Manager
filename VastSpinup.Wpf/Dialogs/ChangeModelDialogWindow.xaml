<Window x:Class="VastSpinup.Wpf.Dialogs.ChangeModelDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Model - VastSpinup"
        Width="620" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Change Model" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" x:Name="InfoText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" />

        <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="New model:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="ModelCombo" DisplayMemberPath="Key" />
        </DockPanel>

        <TextBlock Grid.Row="3" Text="This will: 1) unload current model(s) from VRAM, 2) delete to free disk, 3) pull the new model, 4) smoke-test, 5) rewrite opencode-remote." TextWrapping="Wrap" Foreground="{StaticResource AccentWarning}" Margin="0,0,0,8" />
        <TextBlock Grid.Row="4" x:Name="SkippedText" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" />

        <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Width="96" Height="32" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Switch" IsDefault="True" Click="OkButton_Click"
                    Style="{StaticResource PrimaryButton}" Width="110" Height="32" />
        </DockPanel>
    </Grid>
</Window>
