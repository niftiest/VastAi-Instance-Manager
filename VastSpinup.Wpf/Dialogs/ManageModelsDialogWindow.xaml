<Window x:Class="VastSpinup.Wpf.Dialogs.ManageModelsDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Models - VastSpinup"
        Width="1140" Height="500"
        MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="ModelsGrid" Grid.Row="0"
                  ItemsSource="{Binding}"
                  SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  MouseDoubleClick="ModelsGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="160" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                <DataGridTextColumn Header="Ollama Tag" Binding="{Binding OllamaTag}" Width="280" />
                <DataGridTextColumn Header="VRAM" Binding="{Binding VramGb, StringFormat={}{0} GB}" Width="80" />
                <DataGridTextColumn Header="Disk" Binding="{Binding DiskGb, StringFormat={}{0} GB}" Width="80" />
                <DataGridTextColumn Header="Size" Binding="{Binding ModelSizeGb, StringFormat={}{0:F1} GB}" Width="80" />
                <DataGridTextColumn Header="Max $/hr" Binding="{Binding MaxPricePerHour, StringFormat={}{0:F2}, TargetNullValue=-}" Width="90" />
                <DataGridTextColumn Header="Min Rel." Binding="{Binding MinReliability, StringFormat={}{0:F2}}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="Add" Click="AddButton_Click" Width="100" Height="34" />
            <Button DockPanel.Dock="Left" Content="Edit" Click="EditButton_Click" Width="100" Height="34" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Left" Content="Delete" Click="DeleteButton_Click"
                    Style="{StaticResource DangerButton}" Width="100" Height="34" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="CloseButton_Click"
                    Width="120" Height="34" />
        </DockPanel>
    </Grid>
</Window>
